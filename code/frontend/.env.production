# Im Betrieb (npm run build) absichtlich leer: Das Frontend ruft relativ /api/... auf, und nginx
# reicht das an das Backend weiter.
VITE_API_BASE_URL=

# Key des Admin-Rechts. Muss zu gebiter.accessrole.admin-key im Backend passen.
VITE_ADMIN_ACCESS_ROLE_KEY=ADMIN

# Key des File-Manager-Rechts (Modul File-Manager). Muss zu gebiter.accessrole.file-manager-key im Backend passen.
VITE_FILE_MANAGER_ACCESS_ROLE_KEY=FILE_MANAGER

# Der Solr-Kern der Dateien (File-Kern). Muss zu gebiter.file.solr-core-key im Backend passen.
VITE_FILE_SOLR_CORE_KEY=FILE

# Höchstens so viele Dateien in einer Upload-Liste (FileDropzone mit multiple). Danach erst hochladen.
VITE_UPLOAD_MAX_FILES_PER_LIST=25

# So viele Dateien einer Upload-Liste gehen gleichzeitig zum Backend (passt zum SFTP-Broker: 2 Verbindungen je User).
VITE_UPLOAD_MAX_PARALLEL_UPLOADS=2

# So oft fragt die Upload-Seite nach, ob die Auswertung (Tika, Texterkennung, Vorschau) einer Datei fertig ist.
VITE_FILE_ANALYSIS_POLL_SECONDS=3

# So oft fragt der Header nach, wie viele User online sind (nur solange der Tab sichtbar ist).
VITE_ONLINE_USERS_POLL_SECONDS=120
