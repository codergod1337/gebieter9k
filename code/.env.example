# Vorlage für die lokale .env – kopieren nach .env und Passwörter setzen.
# Die echte .env gehört nie ins Git (siehe .gitignore).
#
# WERTE NUR IN ASCII (keine Umlaute, kein ß, kein €): Compose liest die Datei
# als UTF-8, Spring Boot importiert sie später als Properties-Datei
# (ISO-8859-1). Ein Sonderzeichen im Passwort käme dort anders an.
#
# *_HOST_PORT ist jeweils der Port auf dem Mac; im Container bleiben es
# 5432 (Postgres), 8983 (Solr) und 22 (SFTP).

# Netzwerk-Profil des Backends (von wo aus es Postgres, Solr und SFTP anspricht): steht NICHT hier.
# backend/start.sh erkennt es bei jedem Start und gibt es als Umgebungsvariable NETWORK_PROFILE mit:
#   WEB = unterwegs, der SSH-Tunnel läuft (docu/setup.md 5.8): Hosts *_HOST_WEB
#   LAN = zu Hause, direkt über die IP des Pi: Hosts *_HOST_LAN
# Erkannt wird der Pi am Host-Key SFTP_HOST_KEY unter SFTP_HOST_WEB bzw. SFTP_HOST_LAN.

# Ablage der Daten, relativ zu compose.yaml
MOUNTS_DIR=../mounts

# PostgreSQL
# *_HOST_LAN / *_HOST_WEB: Adressen aus Sicht des Backends je Netzwerk-Profil (siehe NETWORK_PROFILE).
POSTGRES_HOST_LAN=192.168.1.7
POSTGRES_HOST_WEB=localhost
POSTGRES_HOST_PORT=9005
POSTGRES_DB=thomas_db
POSTGRES_USER=gebiter
POSTGRES_PASSWORD=change-me

# Solr
SOLR_HOST_LAN=192.168.1.7
SOLR_HOST_WEB=localhost
SOLR_HOST_PORT=9009
SOLR_USER=admin-solr
SOLR_PASSWORD=change-me
# Solr-Kerne, kommagetrennt (z. B. FILE). Leer: noch keiner.
SOLR_CORES=

# SFTP (Dateispeicher). SFTP_HOST_LAN/SFTP_HOST_WEB sind die Adressen aus Sicht des Backends.
# SFTP_HOST_KEY: oeffentlicher Host-Key des Servers, Typ und Schluessel ohne Hostnamen:
#   cut -d " " -f 1,2 ../mounts/sftp/ssh_host_ed25519_key.pub
# Nur genau dieser Server wird akzeptiert (Schutz gegen Man-in-the-Middle).
SFTP_HOST_LAN=192.168.1.7
SFTP_HOST_WEB=localhost
SFTP_HOST_PORT=9022
SFTP_USER=admin-sftp
SFTP_PASSWORD=
SFTP_HOST_KEY=

# E-Mail (SMTP), zum Durchprobieren der Anbieter: Test im Admin-Tab "Mail-Test". Nach einer Aenderung Backend neu starten.
#   Yahoo:  SMTP_HOST=smtp.mail.yahoo.com SMTP_PORT=587  (nur mit App-Passwort aus den Yahoo-Kontoeinstellungen)
#   GMX:    SMTP_HOST=mail.gmx.net    SMTP_PORT=587  (im Postfach vorher "POP3/IMAP Abruf" erlauben)
#   web.de: SMTP_HOST=smtp.web.de     SMTP_PORT=587  (im Postfach vorher POP3/IMAP aktivieren)
#   Gmail:  SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  (nur mit App-Passwort, dafuer 2-Schritt-Bestaetigung an)
#   Port 465 statt 587: SMTP_STARTTLS=false und SMTP_SSL=true
# SMTP_USERNAME ist meist die volle E-Mail-Adresse. MAIL_FROM leer = SMTP_USERNAME.
# MAIL_TEST_RECIPIENT: Vorbelegung des Empfaengers der Test-Mail (Admin-Tab und Profil).
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TEST_RECIPIENT=

# Authenticator-App (2FA, TOTP): Schluessel, mit dem das Backend die Geheimnisse in Postgres verschluesselt.
# 32 Zufallsbytes als Base64: openssl rand -base64 32. Wechseln = alle eingerichteten Apps neu einrichten.
TOTP_ENCRYPTION_KEY=
